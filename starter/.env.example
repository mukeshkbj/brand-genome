# Copy to .env and fill in. Nothing here is required to run the demo:
# without keys the editor uses a rule-based fallback and payments run in mock mode.

PORT=3000
# Public https URL of this server (e.g. a tunnel) - needed for real M-Pesa / MoMo callbacks
PUBLIC_URL=http://localhost:3000

# --- Gemini (theme editor) ---
GEMINI_API_KEY=
# Check the exact model id at https://ai.google.dev/gemini-api/docs/models before the build
GEMINI_MODEL=gemini-3.8-flash

# --- Payments: mock | sandbox ---
PAYMENTS_MODE=mock

# MTN MoMo Collection sandbox (https://momodeveloper.mtn.com)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENV=sandbox

# M-Pesa Daraja sandbox (https://developer.safaricom.co.ke)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
